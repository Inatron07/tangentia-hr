# Copy to .env (never commit .env) or set these in your host's environment settings.

# EKB (Automation Anywhere Enterprise Knowledge). API key + secret: EKB > CATS project > Settings > API Keys
EKB_BASE_URL=https://api.getodin.ai/
EKB_API_KEY=
EKB_API_SECRET=
EKB_PROJECT_ID=b5d379edc0134be588136d
EKB_AGENT_ID=66244

# CATS v3 API key (used only to fetch resume files). Use the NEW key, not the one from the screenshot.
CATS_API_KEY=

# Sign-in for the page (HTTP Basic). Strongly recommended: the app exposes candidate data.
APP_USER=hr
APP_PASSWORD=

PORT=3000
# MOCK=1 shows sample replies without any keys (UI testing only).
MOCK=
